---
import DownloadConsent from "./islands/DownloadConsent.vue";
import ThemeSwitcher from "./islands/ThemeSwitcher.vue";
---

<main class="page">
  <header class="header">
    <a class="brand" href="/" aria-label="Writasaurus home">Writasaurus</a>
    <div class="headerActions">
      <ThemeSwitcher client:load />
    </div>
  </header>

  <section class="hero" aria-labelledby="hero-title">
    <div class="copy">
      <p class="eyebrow">A writing space for the long haul</p>
      <h1 id="hero-title">Make room for the story only you can tell.</h1>
      <p class="intro">
        Writasaurus is a focused, local-first manuscript editor for writers who think in chapters.
        Shape your draft, keep your work on your device, and export it as an EPUB when it is ready.
      </p>
      <p class="licenseNote">
        Writasaurus is for personal use and may not be copied or redistributed. Your EPUBs remain
        yours.
      </p>
      <DownloadConsent client:load />
      <p class="privacyNote">Your writing stays yours and on your device.</p>
    </div>
    <div class="art" aria-hidden="true">
      <div class="paper">
        <span class="paperLabel">A NEW CHAPTER</span>
        <span class="line" />
        <span class="line" />
        <span class="lineShort" />
        <span class="chapter">01</span>
      </div>
      <span class="spark">✦</span>
    </div>
  </section>

  <section class="features" aria-label="Writasaurus features">
    <article>
      <h2>Made for manuscripts</h2>
      <p>Organize chapters, follow your word count, and stay with the work in front of you.</p>
    </article>
    <article>
      <h2>Your work, your files</h2>
      <p>Write locally and export a portable EPUB you own and can keep, use, or share.</p>
    </article>
    <article>
      <h2>Quiet by design</h2>
      <p>A calm writing environment keeps the focus on your ideas, not the interface.</p>
    </article>
  </section>

  <footer class="footer">
    <span>© Writasaurus</span>
  </footer>
</main>

<style>
.page {
  background:
    radial-gradient(
    ellipse at 78% 24%,
    color-mix(in srgb, var(--accent) 22%, transparent),
    transparent 33rem
  ),
    var(--bg);
  color: var(--text);
  min-height: 100vh;
  padding: 1.5rem clamp(1.25rem, 6vw, 6rem) 1.75rem;
}

.header,
.footer {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin: 0 auto;
  max-width: 74rem;
}

.headerActions {
  align-items: center;
  display: flex;
  gap: 1.25rem;
}

.brand {
  color: var(--accent-strong);
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: -0.04em;
  text-decoration: none;
}

.headerLink,
.footer a {
  color: var(--muted);
  font-size: 0.9rem;
  text-underline-offset: 0.2em;
}

.hero {
  align-items: center;
  display: grid;
  gap: clamp(2rem, 7vw, 7rem);
  grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
  margin: 3.75rem auto 4.5rem;
  max-width: 66rem;
  min-height: 28rem;
}

.copy {
  max-width: 38rem;
}

.eyebrow {
  color: var(--accent);
  font-size: 0.8rem;
  font-weight: 750;
  letter-spacing: 0.12em;
  margin-bottom: 1rem;
  text-transform: uppercase;
}

.copy h1 {
  color: var(--accent-strong);
  font-family: var(--font-display);
  font-size: clamp(3rem, 6.5vw, 5.4rem);
  font-weight: 650;
  letter-spacing: -0.045em;
  line-height: 0.98;
  max-width: 11ch;
}

.intro {
  color: var(--muted);
  font-size: clamp(1rem, 1.4vw, 1.15rem);
  line-height: 1.7;
  margin: 1.5rem 0 1.4rem;
  max-width: 37rem;
}

.licenseNote {
  color: var(--muted);
  font-size: 0.9rem;
  line-height: 1.5;
  margin: -0.35rem 0 1rem;
  max-width: 35rem;
}

.privacyNote {
  color: var(--muted);
  font-size: 0.85rem;
  margin-top: 0.9rem;
}

.art {
  align-items: center;
  display: flex;
  justify-content: center;
  min-height: 24rem;
  position: relative;
}

.paper {
  background: var(--surface);
  border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  border-radius: 0.35rem 1.3rem 0.35rem 0.35rem;
  box-shadow: 1.4rem 1.8rem 3.2rem color-mix(in srgb, var(--text) 17%, transparent);
  display: flex;
  flex-direction: column;
  height: 20rem;
  justify-content: center;
  padding: 2.6rem;
  position: relative;
  transform: rotate(3deg);
  width: min(100%, 17rem);
}

.paperLabel {
  color: color-mix(in srgb, var(--muted) 72%, var(--surface));
  font-size: 0.65rem;
  font-weight: 750;
  letter-spacing: 0.15em;
  margin-bottom: 1.8rem;
}

.line,
.lineShort {
  background: color-mix(in srgb, var(--muted) 34%, var(--surface));
  border-radius: 1rem;
  height: 0.45rem;
  margin-bottom: 0.85rem;
  width: 100%;
}

.lineShort {
  width: 67%;
}

.chapter {
  color: color-mix(in srgb, var(--accent) 32%, transparent);
  font-family: var(--font-display);
  font-size: 6rem;
  font-weight: 800;
  line-height: 1;
  position: absolute;
  right: 1.5rem;
  top: 6rem;
}

.spark {
  color: var(--focus-ring);
  font-size: 3rem;
  position: absolute;
  right: 8%;
  top: 12%;
}

.features {
  border-bottom: 1px solid var(--border);
  border-top: 1px solid var(--border);
  display: grid;
  gap: 2.5rem;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 0 auto;
  max-width: 74rem;
  padding: 2rem 0;
}

.features h2 {
  color: var(--accent-strong);
  font-family: var(--font-display);
  font-size: 1.35rem;
  margin-bottom: 0.45rem;
}

.features p {
  color: var(--muted);
  font-size: 0.95rem;
  line-height: 1.6;
  max-width: 22rem;
}

.footer {
  color: var(--muted);
  font-size: 0.85rem;
  margin-top: 1.5rem;
}

@media (max-width: 48rem) {
  .hero {
    gap: 1.5rem;
    grid-template-columns: 1fr;
    margin: 3.25rem auto;
  }

  .art {
    min-height: 19rem;
  }

  .paper {
    height: 17rem;
  }

  .features {
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
}

@media (max-width: 30rem) {
  .page {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .hero {
    margin-top: 2.5rem;
  }

  .headerActions {
    align-items: flex-end;
    flex-direction: column;
    gap: 0.65rem;
  }

  .copy h1 {
    font-size: clamp(2.7rem, 14vw, 4rem);
  }
}
</style>
