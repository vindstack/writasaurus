---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeSwitcher from "../components/islands/ThemeSwitcher.vue";
---

<BaseLayout title="Writasaurus License Agreement">
  <main class="page">
    <header class="header">
      <a class="brand" href="/" aria-label="Writasaurus home">Writasaurus</a>
      <div class="headerActions">
        <ThemeSwitcher client:load />
        <a class="headerLink" href="/">Back to home</a>
      </div>
    </header>

    <article class="terms">
      <p class="eyebrow">Writasaurus</p>
      <h2>Writasaurus License Agreement</h2>
      <p class="updated">Application use and your writing</p>

      <h3>1. Personal-use license</h3>
      <p>
        Writasaurus is licensed to you for your own personal use. The application is licensed, not
        sold, and this agreement does not transfer ownership of Writasaurus or its included materials
        to you.
      </p>

      <h3>2. Restrictions</h3>
      <p>
        You may not copy, modify, distribute, sublicense, sell, rent, or otherwise share or make
        Writasaurus or copies of the application available to others. These restrictions apply only
        to the application and its included materials, not to manuscripts or EPUBs you create.
        Applicable non-waivable rights are not limited by this agreement.
      </p>

      <h3>3. Your manuscripts and EPUBs</h3>
      <p>
        You retain ownership of the writing and EPUBs you create with Writasaurus. Writasaurus
        claims no ownership of your work. You may keep, use, and distribute your manuscripts and
        EPUBs, subject to any rights belonging to other people in material you include.
      </p>

      <h3>4. The application</h3>
      <p>
        Writasaurus is provided as available, without promises that it will always be uninterrupted
        or error-free. Nothing in this agreement limits rights or remedies that applicable law does
        not allow to be limited.
      </p>

      <p class="draft">
        This is a plain-language product-license draft and has not been reviewed by a lawyer.
      </p>
      <a class="back" href="/">Back to Writasaurus</a>
    </article>

    <footer class="footer">
      <span>© Writasaurus</span>
      <a href="/">Home</a>
    </footer>
  </main>
</BaseLayout>

<style>
.page {
  background:
    radial-gradient(
    ellipse at 78% 24%,
    color-mix(in srgb, var(--accent) 22%, transparent),
    transparent 33rem
  ),
    var(--bg);
  color: var(--text);
  min-height: 100vh;
  padding: 1.5rem clamp(1.25rem, 6vw, 6rem) 1.75rem;
}

.header,
.footer {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin: 0 auto;
  max-width: 74rem;
}

.headerActions {
  align-items: center;
  display: flex;
  gap: 1.25rem;
}

.brand {
  color: var(--accent-strong);
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: -0.04em;
  text-decoration: none;
}

.headerLink,
.footer a {
  color: var(--muted);
  font-size: 0.9rem;
  text-underline-offset: 0.2em;
}

.footer {
  color: var(--muted);
  font-size: 0.85rem;
  margin-top: 1.5rem;
}

@media (max-width: 30rem) {
  .page {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .headerActions {
    align-items: flex-end;
    flex-direction: column;
    gap: 0.65rem;
  }
}

.terms {
  background: var(--surface);
  border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  border-radius: 0.6rem 1.5rem 0.6rem 0.6rem;
  box-shadow: 0 1.4rem 3.5rem color-mix(in srgb, var(--text) 12%, transparent);
  margin: 3.75rem auto 4.5rem;
  max-width: 54rem;
  padding: clamp(1.5rem, 5vw, 3.5rem);
}

.eyebrow {
  color: var(--accent);
  font-size: 0.8rem;
  font-weight: 750;
  letter-spacing: 0.12em;
  margin-bottom: 0.75rem;
  text-transform: uppercase;
}

.terms h2 {
  color: var(--accent-strong);
  font-family: var(--font-display);
  font-size: clamp(2.3rem, 5vw, 3.8rem);
  font-weight: 650;
  letter-spacing: -0.04em;
  line-height: 1.05;
}

.updated {
  color: var(--muted);
  font-size: 1rem;
  margin: 0.8rem 0 2.5rem;
}

.terms h3 {
  color: var(--accent-strong);
  font-family: var(--font-display);
  font-size: 1.35rem;
  margin: 1.8rem 0 0.5rem;
}

.terms > p:not(.eyebrow, .updated, .draft) {
  color: var(--muted);
  line-height: 1.75;
  max-width: 43rem;
}

.draft {
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 0.85rem;
  line-height: 1.6;
  margin-top: 2rem;
  padding-top: 1.25rem;
}

.back {
  color: var(--accent-strong);
  font-weight: 700;
  text-underline-offset: 0.18em;
}

.back:focus-visible {
  outline: 3px solid var(--focus-ring);
  outline-offset: 3px;
}

@media (max-width: 48rem) {
  .terms {
    margin: 2.5rem auto 3rem;
  }
}
</style>
