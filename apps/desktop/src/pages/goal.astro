---
import BaseLayout from "../layouts/BaseLayout.astro";
import CardPage from "../components/CardPage.astro";
import ProjectGoal from "../components/islands/ProjectGoal.vue";
import PageEffects from "../components/islands/PageEffects.vue";
---

<BaseLayout title="Manuscript Goal — Writasaurus">
  <CardPage size="wide" brandHref="/" roomy>
    <h2>Manuscript Goal</h2>
    <p class="intro">
      Track your current manuscript draft against this project's word-count goal.
    </p>
    <ProjectGoal client:load />
  </CardPage>
  <PageEffects client:load />
</BaseLayout>

<style>
  .intro {
    color: var(--muted);
    line-height: 1.6;
  }
</style>
