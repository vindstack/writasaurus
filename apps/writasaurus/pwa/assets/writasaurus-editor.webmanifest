{
  "id": "/editor",
  "name": "Writasaurus",
  "short_name": "Writasaurus",
  "description": "A local-first manuscript editor.",
  "start_url": "/editor",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fffdf7",
  "theme_color": "#fffdf7",
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/writasaurus-editor.webmanifest",
      "id": "https://writasaurus.vindstack.com/editor"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+writasaurus",
      "url": "/editor#launch=%s"
    }
  ],
  "icons": [
    {
      "src": "/writasaurus-editor-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/writasaurus-editor-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
