---
import BaseLayout from "../../layouts/EditorLayout.astro";
import CardPage from "../../components/CardPage.astro";
import Button from "../../../../../packages/shared/ui/components/Button.vue";
import PageEffects from "../../components/islands/PageEffects.vue";
---

<BaseLayout title="About — Writasaurus">
  <CardPage size="medium" prose>
    <h2>About Writasaurus</h2>
    <p>
      Writasaurus is a local-first manuscript editor designed for focused
      long-form writing. Organize your chapters, track word counts in real time,
      and save your EPUB manuscript directly to your device.
    </p>
    <p>
      Writasaurus works in your browser and can be installed as an app. Your
      writing stays entirely in your control, stored locally with automatic
      saving in a focused, chapter-based workspace.
    </p>
    <p>© 2026 Vindstack LLC. Writasaurus is a trademark of Vindstack LLC.</p>
    <div>
      <Button
        href="/editor"
        variant="primary"
        title="Return to Editor (Ctrl+Shift+E)"
      >
        ← Return to Editor
      </Button>
    </div>
  </CardPage>
  <PageEffects client:load />
</BaseLayout>
