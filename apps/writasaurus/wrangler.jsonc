{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "writasaurus-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "issues": {
      "enabled": false,
    },
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "writasaurus-website",
      "migrations_dir": "migrations",
      "database_id": "20fe4217-11c8-4dee-ac18-d3111164eaba",
    },
  ],
}
