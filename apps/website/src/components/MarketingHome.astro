---
import BrandMark from "../../../../packages/shared/ui/components/BrandMark.astro";
---

<main class="page">
    <header class="header">
        <BrandMark href="/" />
        <a class="headerLink" href="/account">Already purchased? Sign in</a>
    </header>

    <section class="hero" aria-labelledby="hero-title">
        <div class="copy">
            <p class="eyebrow">Quiet focus. Big writing ambitions.</p>
            <h1 id="hero-title">Make room for the novel inside you.</h1>
            <p class="intro">
                A calm, private place to build a book one chapter at a time.
                Keep your drafts organized, your momentum steady, and your
                manuscript right where it belongs: with you.
            </p>
            <div class="purchaseActions">
                <a class="button button--primary purchaseButton" href="/checkout">
                    Get Writasaurus — $59.99 USD
                </a>
                <p class="licenseNote">
                    One-time purchase. Personal license for up to two devices.{" "}
                    <a href="/agreement">Terms apply.</a>
                </p>
            </div>
        </div>
        <div class="art" aria-hidden="true">
            <div class="paper">
                <div class="paperTop">
                    <span class="paperLabel">WRITASAURUS · FIELD NOTES</span>
                    <span class="paperNumber">01</span>
                </div>
                <div class="rule" />
                <p class="chapter">Chapter One</p>
                <p class="chapterTitle">A beginning<br />of your own.</p>
                <div class="textLines">
                    <span />
                    <span />
                    <span class="shortLine" />
                </div>
            </div>
        </div>
    </section>

    <section class="features" aria-label="Writasaurus features">
        <article>
            <span class="featureIndex">01</span>
            <h2>A novel's worth of order</h2>
            <p>Chapters, word counts, and gentle daily goals—all in one focused place.</p>
        </article>
        <article>
            <span class="featureIndex">02</span>
            <h2>Your pages stay yours</h2>
            <p>Your manuscript stays on your device and is never used to train AI.</p>
        </article>
        <article>
            <span class="featureIndex">03</span>
            <h2>Ready when you are</h2>
            <p>Keep a Markdown copy, then export an EPUB when it is time to share.</p>
        </article>
    </section>

    <footer class="footer">
        <span>© Writasaurus</span>
        <a href="/agreement">Terms and conditions</a>
    </footer>
</main>

<style>
    .page {
        background:
            radial-gradient(
                ellipse at 80% 20%,
                color-mix(in srgb, var(--accent-warm) 9%, transparent),
                transparent 34rem
            ),
            var(--bg);
        color: var(--text);
        min-height: 100vh;
        padding: 1.5rem clamp(1.5rem, 6vw, 6rem) 1.25rem;
    }

    .header,
    .footer {
        align-items: center;
        display: flex;
        justify-content: space-between;
        margin: 0 auto;
        max-width: 74rem;
    }

    .headerLink,
    .footer a {
        color: var(--muted);
        font-size: 0.9rem;
        text-underline-offset: 0.2em;
    }

    .hero {
        align-items: center;
        display: grid;
        gap: clamp(2rem, 5vw, 5rem);
        grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
        margin: 2.25rem auto 1.75rem;
        max-width: 66rem;
    }

    .copy {
        max-width: 38rem;
    }

    .eyebrow {
        color: var(--accent-warm);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.09em;
        margin-bottom: 1rem;
        text-transform: uppercase;
    }

    .copy h1 {
        color: var(--accent-strong);
        font-family: var(--font-display);
        font-size: clamp(2.9rem, 5.4vw, 4.4rem);
        font-weight: 650;
        letter-spacing: -0.035em;
        line-height: 0.99;
        max-width: 11ch;
    }

    .intro {
        color: var(--muted);
        font-size: clamp(1rem, 1.3vw, 1.12rem);
        line-height: 1.65;
        margin: 1.25rem 0;
        max-width: 35rem;
    }

    .purchaseActions {
        align-items: flex-start;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        margin-top: 1.25rem;
    }

    .purchaseButton {
        color: var(--accent-text);
        min-height: 3rem;
        padding: 0.7rem 1.2rem;
    }

    .licenseNote {
        color: var(--muted);
        font-size: 0.82rem;
        line-height: 1.4;
        max-width: 35rem;
    }

    .licenseNote a {
        color: var(--accent-strong);
        text-underline-offset: 0.18em;
    }

    .art {
        align-items: center;
        display: flex;
        justify-content: center;
        min-height: 19rem;
        position: relative;
    }

    .paper {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.2rem 1.1rem 0.2rem 0.2rem;
        box-shadow: 0 1.2rem 2.5rem color-mix(in srgb, var(--text) 12%, transparent);
        min-height: 17rem;
        padding: 1.8rem 2rem;
        position: relative;
        transform: rotate(2deg);
        width: min(100%, 22rem);
    }

    .paperTop {
        align-items: center;
        color: var(--muted);
        display: flex;
        font-size: 0.58rem;
        font-weight: 700;
        justify-content: space-between;
        letter-spacing: 0.12em;
    }

    .paperNumber {
        color: var(--accent-warm);
        font-family: var(--font-display);
        font-size: 1.1rem;
        letter-spacing: 0;
    }

    .rule {
        background: var(--border);
        height: 1px;
        margin: 0.75rem 0 1.3rem;
    }

    .chapter {
        color: var(--accent-warm);
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-style: italic;
        margin-bottom: 0.3rem;
    }

    .chapterTitle {
        color: var(--accent-strong);
        font-family: var(--font-display);
        font-size: 1.8rem;
        font-weight: 650;
        line-height: 1.02;
        max-width: 11ch;
    }

    .textLines {
        display: grid;
        gap: 0.45rem;
        margin-top: 1.2rem;
        width: 100%;
    }

    .textLines span {
        background: color-mix(in srgb, var(--muted) 35%, var(--surface));
        border-radius: 999px;
        height: 0.28rem;
    }

    .textLines .shortLine {
        width: 62%;
    }

    .features {
        border-bottom: 1px solid var(--border);
        border-top: 1px solid var(--border);
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 1.5rem auto 0;
        max-width: 74rem;
        padding: 1.5rem 0;
    }

    .featureIndex {
        color: var(--accent-warm);
        display: block;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        margin-bottom: 0.25rem;
    }

    .features h2 {
        color: var(--accent-strong);
        font-family: var(--font-display);
        font-size: 1.25rem;
        margin-bottom: 0.35rem;
    }

    .features p {
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.6;
        max-width: 22rem;
    }

    .footer {
        color: var(--muted);
        font-size: 0.85rem;
        margin-top: 1rem;
    }

    @media (max-width: 48rem) {
        .hero {
            gap: 1rem;
            grid-template-columns: 1fr;
            margin: 1.75rem auto 1.25rem;
        }

        .art {
            display: none;
        }

        .features {
            gap: 1.25rem;
            grid-template-columns: 1fr;
            margin-top: 1rem;
            padding: 1.25rem 0;
        }

        .features p {
            font-size: 0.86rem;
        }
    }

    @media (max-width: 30rem) {
        .page {
            padding-left: 1rem;
            padding-right: 1rem;
            padding-top: 1rem;
        }

        .headerLink {
            max-width: 7.5rem;
            text-align: right;
        }

        .copy h1 {
            font-size: clamp(2.6rem, 11.5vw, 3.3rem);
        }

        .intro {
            line-height: 1.5;
            margin: 0.85rem 0;
        }

        .purchaseActions {
            gap: 0.65rem;
            margin-top: 1rem;
        }

        .licenseNote {
            font-size: 0.78rem;
            line-height: 1.35;
        }
    }
</style>
