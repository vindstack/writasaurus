---
import BrandMark from "../../../../packages/shared/ui/components/BrandMark.astro";
---

<main class="page">
    <header class="header">
        <BrandMark href="/" />
        <a class="headerLink" href="/account">Sign in</a>
    </header>

    <section class="hero" aria-labelledby="hero-title">
        <div class="copy">
            <p class="eyebrow">Quiet focus. Big writing ambitions.</p>
            <h1 id="hero-title">
                A quiet, private space for your next chapter.
            </h1>
            <p class="intro">
                A calm, private place to build a book one chapter at a time.
                Keep your drafts organized, your momentum steady, and your
                manuscript right where it belongs: with you.
            </p>
            <div class="downloadActions">
                <a
                    class="button button--primary downloadButton"
                    href="/download"
                >
                    Download for free
                </a>
                <p class="downloadNote">
                    Optional donations support Writasaurus development.
                </p>
            </div>
        </div>
        <div class="art">
            <img
                src="/princess_and_the_goblin.png"
                alt="Writasaurus manuscript editor showing The Princess and the Goblin with its chapter sidebar and writing progress."
                width="997"
                height="699"
                fetchpriority="high"
                decoding="async"
            />
        </div>
    </section>

    <section class="features" aria-label="Writasaurus features">
        <article>
            <span class="featureIndex">01</span>
            <h2>Big books, made easy</h2>
            <p>
                Organize chapters, add introductions and forwards, revise
                easily.
            </p>
        </article>
        <article>
            <span class="featureIndex">02</span>
            <h2>Private by design</h2>
            <p>
                Your work stays on your device, with no account or cloud
                storage, and is never used to train AI.
            </p>
        </article>
        <article>
            <span class="featureIndex">03</span>
            <h2>Stay motivated</h2>
            <p>
                Set writing goals and track your progress to stay motivated and
                productive.
            </p>
        </article>
    </section>

    <footer class="footer">
        <span
            >© 2026 Vindstack LLC. Writasaurus is a trademark of Vindstack LLC.</span
        >
        <a href="/agreement">Terms and conditions</a>
    </footer>
</main>

<style>
    .page {
        background:
            radial-gradient(
                ellipse at 78% 17%,
                color-mix(in srgb, var(--accent-warm) 10%, transparent),
                transparent 34rem
            ),
            var(--bg);
        color: var(--text);
        min-height: 100vh;
        padding: 1.5rem clamp(1.25rem, 5vw, 5rem) 1.5rem;
    }

    .header,
    .footer {
        align-items: center;
        display: flex;
        justify-content: space-between;
        margin: 0 auto;
        max-width: 76rem;
    }

    .header {
        min-height: 3.25rem;
    }

    .headerLink,
    .footer a {
        color: var(--muted);
        font-size: 0.9rem;
        text-underline-offset: 0.2em;
    }

    .hero {
        align-items: center;
        display: grid;
        gap: clamp(2rem, 4vw, 4rem);
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
        margin: 1.5rem auto 3.5rem;
        max-width: 76rem;
        min-height: min(67vh, 41rem);
    }

    .copy {
        max-width: 39rem;
    }

    .eyebrow {
        color: var(--accent-warm);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.09em;
        margin-bottom: 1rem;
        text-transform: uppercase;
    }

    .copy h1 {
        color: var(--accent-strong);
        font-family: var(--font-display);
        font-size: clamp(3.1rem, 6.2vw, 5.2rem);
        font-weight: 650;
        letter-spacing: -0.04em;
        line-height: 0.98;
        max-width: 10ch;
    }

    .intro {
        color: var(--muted);
        font-size: clamp(1.05rem, 1.4vw, 1.18rem);
        line-height: 1.65;
        margin: 1.5rem 0 0;
        max-width: 36rem;
    }

    .downloadActions {
        align-items: flex-start;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        margin-top: 1.75rem;
    }

    .downloadButton {
        box-shadow: 0 0.5rem 1.25rem color-mix(in srgb, var(--accent) 22%, transparent);
        font-size: 1rem;
        font-weight: 700;
        min-height: 3.25rem;
        min-width: 13.5rem;
        padding: 0.75rem 1.25rem;
    }

    .downloadNote {
        color: var(--muted);
        font-size: 0.82rem;
        line-height: 1.4;
        max-width: 35rem;
    }

    .art {
        background: var(--surface);
        border: 1px solid color-mix(in srgb, var(--accent) 14%, var(--border));
        border-radius: 1rem;
        box-shadow:
            0 1.5rem 3rem color-mix(in srgb, var(--text) 12%, transparent),
            0 0.25rem 0.75rem color-mix(in srgb, var(--text) 5%, transparent);
        overflow: hidden;
    }

    .art img {
        display: block;
        height: auto;
        width: 100%;
    }

    .features {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 0 auto;
        max-width: 76rem;
    }

    .features article {
        background: color-mix(in srgb, var(--surface) 78%, transparent);
        border: 1px solid var(--border);
        border-radius: 0.85rem;
        padding: 1.5rem;
    }

    .featureIndex {
        color: var(--accent-warm);
        display: block;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        margin-bottom: 0.6rem;
    }

    .features h2 {
        color: var(--accent-strong);
        font-family: var(--font-display);
        font-size: 1.25rem;
        margin-bottom: 0.45rem;
    }

    .features p {
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.6;
        max-width: 22rem;
    }

    .footer {
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.85rem;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.25rem;
    }

    @media (max-width: 56rem) {
        .hero {
            gap: 2rem;
            grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.8fr);
            min-height: 0;
        }

    }

    @media (max-width: 44rem) {
        .page {
            padding-top: 1rem;
        }

        .hero {
            gap: 2rem;
            grid-template-columns: 1fr;
            margin: 2.5rem auto 3rem;
        }

        .copy {
            max-width: 35rem;
        }

        .copy h1 {
            font-size: clamp(3rem, 11vw, 4.5rem);
        }

        .intro {
            margin-top: 1.1rem;
        }

        .downloadActions {
            margin-top: 1.35rem;
        }

        .features {
            gap: 0.75rem;
            grid-template-columns: 1fr;
        }

        .features article {
            padding: 1.25rem;
        }
    }

    @media (max-width: 30rem) {
        .page {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        .headerLink {
            max-width: 7.5rem;
            text-align: right;
        }

        .copy h1 {
            font-size: clamp(2.75rem, 12vw, 3.4rem);
        }

        .downloadButton {
            width: 100%;
        }

        .downloadActions {
            align-items: stretch;
        }

        .downloadNote {
            font-size: 0.78rem;
        }


        .paper {
            min-height: 16rem;
        }

        .chapterTitle {
            font-size: 1.8rem;
        }

        .footer {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.5rem;
        }
    }
</style>
