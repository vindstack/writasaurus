---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandMark from "../../../../packages/shared/ui/components/BrandMark.astro";
---

<BaseLayout title="Writasaurus terms">
  <main class="page">
    <header class="header">
      <BrandMark href="/" />
      <a class="headerLink" href="/">Back to home</a>
    </header>

    <article class="terms">
      <p class="eyebrow">Writasaurus</p>
      <h1>Terms and donations</h1>
      <p class="updated">Free desktop downloads and optional support</p>

      <h2>Free downloads and your work</h2>
      <p>
        Writasaurus is available as a free desktop download. No purchase, license key, account, or
        internet connection is required to use the downloaded application. You retain ownership of
        the writing and EPUBs you create with Writasaurus.
      </p>

      <h2>Optional donations</h2>
      <p>
        Donations are voluntary, one-time USD payments processed by Stripe. A donation does not
        purchase a license, change access to Writasaurus, or unlock features. An email address is
        required to make a donation so it can be associated with your account and receipt.
      </p>

      <h2>Accounts and email</h2>
      <p>
        Anyone who provides an email can access an account, whether or not they donate.
        Passwordless sign-in codes are sent when requested and are necessary to access your account.
        The account preference controls optional marketing emails only; passcode emails are separate.
        You can change the marketing-email preference in your account.
      </p>

      <h2>Payment and privacy</h2>
      <p>
        Stripe processes payment details. Writasaurus stores donation details needed to show donor
        receipts and maintain account preferences. Manuscripts remain on your device and are not
        uploaded to your account.
      </p>

      <p class="draft">
        These terms describe the current product and donation flow and should be reviewed for
        applicable legal and privacy requirements.
      </p>
      <a class="back" href="/">Back to Writasaurus</a>
    </article>

    <footer class="footer">
      <span>© 2026 Vindstack LLC. Writasaurus is a trademark of Vindstack LLC.</span>
      <a href="/">Home</a>
    </footer>
  </main>
</BaseLayout>

<style>
.page {
  background:
    radial-gradient(
    ellipse at 78% 24%,
    color-mix(in srgb, var(--accent) 22%, transparent),
    transparent 33rem
  ),
    var(--bg);
  color: var(--text);
  min-height: 100vh;
  padding: 1.5rem clamp(1.25rem, 6vw, 6rem) 1.75rem;
}

.header,
.footer {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin: 0 auto;
  max-width: 74rem;
}

.headerLink,
.footer a {
  color: var(--muted);
  font-size: 0.9rem;
  text-underline-offset: 0.2em;
}

.footer {
  color: var(--muted);
  font-size: 0.85rem;
  margin-top: 1.5rem;
}

.terms {
  background: var(--surface);
  border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  border-radius: 0.6rem 1.5rem 0.6rem 0.6rem;
  box-shadow: 0 1.4rem 3.5rem color-mix(in srgb, var(--text) 12%, transparent);
  margin: 3.75rem auto 4.5rem;
  max-width: 54rem;
  padding: clamp(1.5rem, 5vw, 3.5rem);
}

.eyebrow {
  color: var(--accent);
  font-size: 0.8rem;
  font-weight: 750;
  letter-spacing: 0.12em;
  margin-bottom: 0.75rem;
  text-transform: uppercase;
}

.terms h1 {
  color: var(--accent-strong);
  font-family: var(--font-display);
  font-size: clamp(2.3rem, 5vw, 3.8rem);
  font-weight: 650;
  letter-spacing: -0.04em;
  line-height: 1.05;
}

.updated {
  color: var(--muted);
  font-size: 1rem;
  margin: 0.8rem 0 2.5rem;
}

.terms h2 {
  color: var(--accent-strong);
  font-family: var(--font-display);
  font-size: 1.35rem;
  margin: 1.8rem 0 0.5rem;
}

.terms > p:not(.eyebrow, .updated, .draft) {
  color: var(--muted);
  line-height: 1.75;
  max-width: 43rem;
}

.draft {
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 0.85rem;
  line-height: 1.6;
  margin-top: 2rem;
  padding-top: 1.25rem;
}

.back {
  color: var(--accent-strong);
  font-weight: 700;
  text-underline-offset: 0.18em;
}

@media (max-width: 48rem) {
  .terms {
    margin: 2.5rem auto 3rem;
  }
}
</style>
