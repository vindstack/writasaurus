---
import BaseLayout from "../layouts/BaseLayout.astro";
import SitePage from "../components/SitePage.astro";
const cancelled = Astro.url.searchParams.get("cancelled") === "1";
const mockPayments = Deno.env.get("PAYMENT_PROVIDER") === "mock" &&
  Deno.env.get("DENO_DEPLOYMENT_ID") === undefined;
---

<BaseLayout title="Buy Writasaurus">
  <SitePage>
    <h1>Get Writasaurus</h1>
    <p>One-time purchase: <strong>$59.99 USD</strong>. Includes desktop app updates and a license
      for up to two devices.</p>
    {cancelled && <p role="status">Checkout was cancelled. You have not been charged.</p>}
    <form action="/api/checkout" method="post">
      <label for="email">Email address</label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
      <p>We’ll send your license key and purchase details to this address.</p>
      <button type="submit">{mockPayments ? "Create local test purchase" : "Continue to secure checkout"}</button>
    </form>
    {mockPayments && <p>Local mock payments are enabled. No real payment will be taken.</p>}
    <p><a href="/agreement">Terms and conditions</a></p>
  </SitePage>
</BaseLayout>
