---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { decryptLicenseKey, hashText } from "../../lib/license-crypto.ts";
import { isLocalMockEnabled, fulfillConfirmedStripePurchase } from "../../lib/payment-service.ts";
import { getLicenseStore } from "../../lib/store.ts";

const sessionId = Astro.url.searchParams.get("session_id") ?? "";
let revealedKey = "";
let purchaseEmail = "";
let message = "We couldn’t verify this purchase yet. If you were charged, check your inbox shortly.";

if (sessionId && (
  (isLocalMockEnabled() && sessionId.startsWith("mock_")) ||
  /^cs_(test|live)_[A-Za-z0-9]+$/.test(sessionId)
)) {
  try {
    const { confirmStripePurchase } = await import("../../lib/payment-service.ts");
    const session = await confirmStripePurchase(sessionId);
    const purchase = await fulfillConfirmedStripePurchase(session);
    purchaseEmail = purchase.email;
    const claim = await getLicenseStore().claimKeyReveal(sessionId, await hashText(sessionId));
    if (claim) {
      revealedKey = await decryptLicenseKey(claim.encryptedKey);
      message = "Your purchase is confirmed. Save this license key; it is shown here only once.";
    } else {
      message = "Your purchase is confirmed. Your license key has already been revealed; check your email.";
    }
  } catch (error) {
    console.error(
      `Could not complete purchase confirmation: ${error instanceof Error ? error.message : error}`,
    );
  }
}

Astro.response.headers.set("cache-control", "no-store");
Astro.response.headers.set("referrer-policy", "no-referrer");
---

<BaseLayout title="Writasaurus purchase">
  <main>
    <a href="/">Writasaurus</a>
    <h1>Thank you</h1>
    <p role="status">{message}</p>
    {revealedKey && <section aria-label="Your license key">
      <h2>Your license key</h2>
      <p><code>{revealedKey}</code></p>
      <p>Keep it somewhere safe. You’ll need it to activate Writasaurus on your devices.</p>
    </section>}
    {purchaseEmail && <p>Purchase details were sent to <strong>{purchaseEmail}</strong>.</p>}
    <p><a href="/account">Go to your account</a></p>
  </main>
</BaseLayout>
