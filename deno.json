{
  "workspace": ["./apps/desktop", "./apps/website", "./packages/shared"],
  "imports": {
    "@db/postgres": "jsr:@db/postgres@0.19.5",
    "@astrojs/check": "npm:@astrojs/check@^0.9.10",
    "@astrojs/vue": "npm:@astrojs/vue@^7.0.3",
    "@deno/astro-adapter": "npm:@deno/astro-adapter@^0.6.0",
    "@types/node": "npm:@types/node@^26.6.4",
    "astro": "npm:astro@^7.3.5",
    "harper.js": "npm:harper.js@2.10.0",
    "playwright": "npm:playwright@^1.63.0",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "typescript": "npm:typescript@^6.0.3",
    "vue": "npm:vue@^3.5.43"
  },
  "nodeModulesDir": "manual",
  "desktop": {
    "app": {
      "name": "Writasaurus",
      "identifier": "io.github.8bitreed.dino-writer"
    },
    "output": {
      "linux": "./desktop/Writasaurus.AppImage",
      "windows": "./desktop/Writasaurus.msi",
      "macos": "./desktop/Writasaurus"
    }
  },
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "lib": ["deno.window", "deno.unstable", "deno.desktop", "dom", "dom.iterable"]
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "dev": "deno --env-file=.env task --cwd apps/website dev",
    "dev:server": "deno --env-file=.env task --cwd apps/website dev",
    "build": "deno task --cwd apps/desktop build && deno task --cwd apps/website build",
    "desktop:build": "deno task --cwd apps/desktop build",
    "website:build": "deno task --cwd apps/website build",
    "start": "deno task --cwd apps/website start",
    "desktop": "deno task --cwd apps/desktop desktop",
    "desktop:dev": "deno task --cwd apps/desktop desktop:dev",
    "test": "deno task --cwd apps/desktop test && deno task --cwd apps/website test",
    "check": "deno fmt --check apps scripts packages deno.json .env.example README.md && deno lint && deno check scripts/release-desktop.ts scripts/prepare-latest.ts scripts/db-migrate.ts scripts/generate-license-secrets.ts && deno task --cwd apps/desktop check && deno task --cwd apps/website check && deno task test",
    "license:secrets": "deno run scripts/generate-license-secrets.ts",
    "db:dev:up": "docker compose up -d --wait postgres",
    "db:dev:down": "docker compose stop postgres",
    "db:migrate": "deno run --env-file=.env --allow-env=DATABASE_URL --allow-net --allow-read=apps/website/migrations scripts/db-migrate.ts",
    "release:desktop": "deno run --env-file=.env --allow-read=deno.json,apps/desktop,desktop,apps/website/public --allow-write=apps/desktop/dist,desktop,apps/website/public --allow-run=deno --allow-env=WRITASAURUS_R2_ACCOUNT_ID,WRITASAURUS_R2_ACCESS_KEY_ID,WRITASAURUS_R2_SECRET_ACCESS_KEY,WRITASAURUS_R2_BUCKET,WRITASAURUS_R2_PUBLIC_BASE_URL scripts/release-desktop.ts",
    "release:latest": "deno run --allow-read=apps/website/public --allow-write=apps/website/public scripts/prepare-latest.ts"
  }
}
