# Local release publishing
WRITASAURUS_R2_ACCOUNT_ID=
WRITASAURUS_R2_ACCESS_KEY_ID=
WRITASAURUS_R2_SECRET_ACCESS_KEY=
WRITASAURUS_R2_BUCKET=
WRITASAURUS_R2_PUBLIC_BASE_URL=

# Website runtime: Stripe, email, Postgres, and signed sessions
DATABASE_URL=postgres://writasaurus:local-dev-password@127.0.0.1:5432/writasaurus
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PUBLIC_SITE_URL=https://writasaurus.com
ADMIN_EMAIL=josh@vindstack.com
SESSION_SECRET=
LICENSE_ENCRYPTION_KEY=
LICENSE_SIGNING_PRIVATE_KEY=

# Desktop build-time public settings (not secrets); the key name matches generator output.
PUBLIC_LICENSE_API_URL=https://writasaurus.com
PUBLIC_LICENSE_SIGNING_PUBLIC_KEY=

# Generate secrets with a cryptographically secure random generator.
# LICENSE_ENCRYPTION_KEY must encode 32 random bytes as base64url.
# LICENSE_SIGNING_PRIVATE_KEY must be an Ed25519 PKCS#8 private key as base64url.
# SESSION_SECRET must contain at least 32 random characters.
